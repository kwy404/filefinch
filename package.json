{
  "name": "filefinch",
  "version": "0.2.0",
  "private": false,
  "description": "Send files and folders straight between your own devices in the browser, peer to peer over WebRTC.",
  "keywords": [
    "file transfer",
    "peer to peer",
    "p2p",
    "webrtc",
    "browser",
    "end to end encryption",
    "folder sync",
    "pwa"
  ],
  "homepage": "https://kwy404.github.io/filefinch/",
  "bugs": {
    "url": "https://github.com/kwy404/filefinch/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kwy404/filefinch.git"
  },
  "license": "MIT",
  "author": "Alexandre Kohler (https://github.com/kwy404)",
  "type": "module",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build:app": "node scripts/build-app.mjs",
    "check:app": "node scripts/build-app.mjs --check",
    "build:site": "node scripts/site/build-site.mjs",
    "build:art": "node scripts/site/build-art.mjs --png",
    "lint": "eslint .",
    "check:rules": "node scripts/check-rules.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node test/app-e2e.mjs",
    "test:e2e:words": "node test/app-e2e-words.mjs",
    "serve": "node scripts/serve.mjs",
    "test:site": "node test/site-qa.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@scure/bip39": "^2.4.0",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "jsqr": "^1.4.0",
    "playwright-core": "^1.64.1",
    "vitest": "^3.2.7"
  }
}
