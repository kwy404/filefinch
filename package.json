    "webrtc file transfer",
    "webrtc data channel",
    "browser file transfer",
    "airdrop alternative",
    "airdrop for windows",
    "send files without cloud",
    "no account file sharing",
    "end to end encrypted file transfer",
    "folder sync",
    "sync folders between computers",
    "resume file transfer",
    "serverless",
    "pwa",
    "offline",
    "qr code",
    "file system access api",
    "local first"
  ],
  "homepage": "https://kwy404.github.io/filefinch/",
  "bugs": {
    "url": "https://github.com/kwy404/filefinch/issues"
  },
